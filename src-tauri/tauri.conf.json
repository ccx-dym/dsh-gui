{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DSH Desktop",
  "version": "0.1.11",
  "identifier": "com.community.dsh-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true
      },
      {
        "label": "updates",
        "title": "DSH Desktop · 更新",
        "url": "index.html",
        "width": 760,
        "height": 620,
        "minWidth": 640,
        "minHeight": 520,
        "visible": false,
        "resizable": true
      },
      {
        "label": "appearance",
        "title": "DSH Desktop · 外观",
        "url": "index.html?view=appearance",
        "width": 760,
        "height": 720,
        "minWidth": 680,
        "minHeight": 620,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["local-main", "local-appearance", "official-skin-report"],
      "csp": "default-src 'self'; img-src 'self' data: dsh-skin: http://dsh-skin.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
